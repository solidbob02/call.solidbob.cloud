# =============================================================================
# import-linter — CallGuard fastapi/ 아키텍처 하네스 (코드 레벨)
# =============================================================================
# 두 개의 직교하는 구조 규칙을 정적 분석으로 강제한다. 설명 → docs/harness.md §1
#   (1) 앱 '내부'  — 헥사고날/클린: adapter → app → domain (역방향 금지)
#   (2) 앱 '사이'  — 스타 토폴로지: hub(허브) 중심, 스포크끼리 직접 참조 금지
#
# 실행:
#   cd fastapi && PYTHONPATH=apps lint-imports --config .importlinter
#
# (apps/ 를 경로에 올려야 hub·evaluation 등이 최상위 패키지로 보인다. main.py 의 sys.path.insert 와 동일한 맥락.)
# 스포크를 새로 만들면 아래 다섯 목록 전부에 이름을 추가한다 (docs/architecture.md §1 의 표 순서).
# 아직 없는 패키지를 적으면 lint-imports 가 "모듈 없음"으로 실패하므로, 실제로 만든 것만 적는다.
# 예정: retrieval · generation · compliance · masking · closure_gate · postcall
# =============================================================================

[importlinter]
root_packages =
    hub
    evaluation
    core
include_external_packages = True

# -----------------------------------------------------------------------------
# 계약 1) 클린 아키텍처 — 모든 앱 내부에서 adapter > app > domain
# -----------------------------------------------------------------------------
# 상위(adapter)는 하위(app·domain)를 import 할 수 있고, 하위는 상위를 import 할 수 없다.
# 괄호 = 그 계층이 없는 앱을 허용 (hub 는 domain 없음, evaluation 은 채점 코드라 계층 분리 없음).
[importlinter:contract:clean-architecture]
name = 클린 아키텍처 계층 (adapter > app > domain) — 허브·전 스포크 공통
type = layers
layers =
    (adapter)
    (app)
    (domain)
containers =
    hub
    evaluation

# -----------------------------------------------------------------------------
# 계약 2) 스타 토폴로지 — 스포크는 서로를 import 하지 않는다
# -----------------------------------------------------------------------------
# 파이프라인 배선(마스킹 → 트리거 → 검색 → 생성)은 허브 포트 경유. (허브는 목록 제외 — 스포크→허브 허용.)
# evaluation 은 골든셋으로 스포크를 채점하지만 hub 포트(추상)로만 접점을 두므로 스포크를 import 하지 않는다.
[importlinter:contract:spoke-independence]
name = 스포크 상호 독립 (스포크 ↔ 스포크 직접 참조 금지)
type = independence
modules =
    evaluation

# -----------------------------------------------------------------------------
# 계약 3) 프레임워크 격리 — app·domain 계층은 웹/DB/검색엔진/모델 프레임워크를 모른다
# -----------------------------------------------------------------------------
# HTTP(fastapi)·DB(sqlalchemy/pymysql)·검색(elasticsearch)·모델(transformers/torch)·STT(google)는
# adapter 계층의 관심사다. (pydantic 은 app/dtos 에서 실용적으로 허용, domain 에서는 금지 — 계약 4.)
[importlinter:contract:framework-isolation]
name = 프레임워크 격리 (app·domain → fastapi/sqlalchemy/elasticsearch/transformers import 금지)
type = forbidden
source_modules =
    hub.app
    evaluation
forbidden_modules =
    fastapi
    sqlalchemy
    pymysql
    elasticsearch
    transformers
    torch
    sentence_transformers
    google

# -----------------------------------------------------------------------------
# 계약 4) 도메인 순수성 — domain 계층은 pydantic 도 모른다 (순수 파이썬)
# -----------------------------------------------------------------------------
# C-5 마스킹 규칙·F-2 게이트 판정이 여기 산다. "판정은 규칙이 한다"(절대 원칙 9)를 코드 구조로 고정하는 계약.
# hub 에는 domain 이 없으므로 지금은 evaluation 만. 스포크가 생기면 <스포크>.domain 을 추가한다.
[importlinter:contract:domain-purity]
name = 도메인 순수성 (domain → pydantic import 금지)
type = forbidden
source_modules =
    evaluation
forbidden_modules =
    pydantic

# -----------------------------------------------------------------------------
# 계약 5) 허브 격리 — 허브(hub)는 스포크에 의존하지 않는다
# -----------------------------------------------------------------------------
# 허브는 계약(포트/DTO)만 제공하고 구체 스포크 패키지를 import 하지 않는다.
[importlinter:contract:hub-isolation]
name = 허브 격리 (hub → 스포크 import 금지)
type = forbidden
source_modules =
    hub
forbidden_modules =
    evaluation
