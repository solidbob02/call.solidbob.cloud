%% 실시간 상담원 어시스트 RAG — MySQL 스키마 ERD (3NF 정규화 후)
%% 기준: 기획서 rev.4 3절 + 인터페이스 계약 3종. 정규화 근거는 normalization.md.
%% 렌더: npx -y @mermaid-js/mermaid-cli@11 -i schema.mmd -o schema.png -b white -w 2400 -c mmd-config.json
%% 주의: 한글 폰트가 없는 환경에서 렌더하면 한글이 전부 네모(두부)로 나온다. ../architecture.md 참조.

erDiagram
    agent              ||--o{ call               : "담당"
    call               ||--o{ transcript         : "전사 스트림"
    transcript         ||--o{ transcript_mask    : "마스킹 구간"
    pii_pattern        ||--o{ transcript_mask    : "패턴 종류"

    call               ||--o{ recommendation     : "추천 이력"
    recommendation     ||--o{ recommendation_card: "카드"
    kb_document        ||--o{ recommendation_card: "근거 문서"

    call               ||--o{ compliance_alert   : "경고 이력"
    compliance_rule    ||--o{ compliance_alert   : "규칙"

    call               ||--o| closure            : "종결 판정 (F-2)"
    closure_type       ||--o{ closure            : "처리 유형"
    closure_type       ||--o{ closure_requirement: "필수 요건 정의"
    closure            ||--o{ closure_evidence   : "요건별 충족 여부"
    closure_requirement||--o{ closure_evidence   : "요건"
    kb_document        ||--o{ closure            : "판정 근거"

    eval_run           ||--o{ eval_metric        : "지표"

    agent {
        varchar  agent_id        PK "상담원 식별자"
        varchar  display_name       "표시 이름"
        varchar  team               "소속"
    }

    call {
        varchar  call_id         PK "통화 식별자 c_001"
        varchar  agent_id        FK "agent.agent_id"
        datetime started_at         "통화 시작"
        datetime ended_at           "통화 종료"
        enum     channel_layout     "stereo | mono (V1)"
        enum     status             "in_progress | ended"
    }

    transcript {
        bigint   transcript_id   PK "자동 증가"
        varchar  call_id         FK "call.call_id"
        enum     speaker            "customer | agent"
        text     text_masked        "C-5 적용 후. 원본 미저장"
        boolean  is_final           "false = 부분 결과"
        int      utterance_end_ms   "발화 종료 — 트리거 채점 기준점"
        datetime created_at         "적재 시각"
    }

    pii_pattern {
        char     pattern_code    PK "P1 ~ P7"
        varchar  label              "주민번호 / 카드번호 / 인명 ..."
        enum     detector           "regex | ner"
        boolean  in_absolute_scope  "절대 규칙 범위 여부"
    }

    transcript_mask {
        bigint   mask_id         PK "자동 증가"
        bigint   transcript_id   FK "transcript.transcript_id"
        char     pattern_code    FK "pii_pattern.pattern_code"
        int      span_start         "시작 오프셋"
        int      span_end           "끝 오프셋"
    }

    recommendation {
        bigint   recommendation_id PK "자동 증가"
        varchar  call_id           FK "call.call_id"
        int      trigger_at_ms        "트리거 발동 시각"
        enum     mode                 "generated | snippet (폴백)"
        int      internal_latency_ms  "트리거 → 표시 (p95 <= 1000)"
        int      e2e_latency_ms       "발화 종료 → 표시 (기록만)"
        datetime created_at           "생성 시각"
    }

    kb_document {
        varchar  doc_id          PK "ES 인덱스와 동일 ID"
        varchar  title              "요금제약관 / 응대매뉴얼 ..."
        enum     doc_type           "terms | manual | internal_rule"
        varchar  source_version     "수집 시점 버전"
    }

    recommendation_card {
        bigint   card_id         PK "자동 증가"
        bigint   recommendation_id FK "recommendation.recommendation_id"
        smallint rank_no            "표시 순서"
        varchar  title              "카드 제목"
        text     summary            "근거 요약 또는 원문 스니펫"
        varchar  doc_id          FK "kb_document.doc_id"
        varchar  clause_ref         "조항 — 3.2 / 7장"
        decimal  score              "유사도"
    }

    compliance_rule {
        varchar  rule_code       PK "absolute_guarantee ..."
        varchar  label              "규칙 이름"
        enum     default_severity   "high | medium | low"
        varchar  suggestion         "권장 대체 표현 (C-4)"
    }

    compliance_alert {
        bigint   alert_id        PK "자동 증가"
        varchar  call_id         FK "call.call_id"
        varchar  rule_code       FK "compliance_rule.rule_code"
        int      at_ms              "감지 시각"
        varchar  matched_text       "감지된 표현 (마스킹 후)"
        datetime created_at         "적재 시각"
    }

    closure_type {
        varchar  closure_type_code PK "해지 | 명의변경 | 보상환불"
        varchar  label                "표시 이름"
    }

    closure_requirement {
        varchar  closure_type_code PK "closure_type.closure_type_code"
        varchar  requirement_code  PK "위약금_안내 ..."
        varchar  label                "요건 설명"
        boolean  is_mandatory         "필수 여부"
        varchar  doc_id            FK "근거 규정 문서"
        varchar  clause_ref           "근거 조항"
    }

    closure {
        bigint   closure_id      PK "자동 증가"
        varchar  call_id         FK "call.call_id"
        varchar  closure_type_code FK "closure_type.closure_type_code"
        varchar  reason             "상담원이 입력한 종결 사유"
        enum     verdict            "passed | blocked — 규칙이 판정"
        varchar  doc_id          FK "판정 근거 문서"
        varchar  clause_ref         "판정 근거 조항"
        datetime decided_at         "판정 시각"
    }

    closure_evidence {
        bigint   evidence_id     PK "자동 증가"
        bigint   closure_id      FK "closure.closure_id"
        varchar  requirement_code FK "closure_requirement.requirement_code"
        boolean  is_satisfied       "충족 여부 (미충족이 missing)"
        varchar  evidence_ref       "근거가 된 전사·입력 위치"
    }

    eval_run {
        varchar  run_id          PK "평가 실행 식별자"
        varchar  commit_sha         "측정 시점 커밋"
        varchar  command            "재현 명령"
        varchar  golden_set_ver     "골든셋 버전 (10 / 50 / 150)"
        int      n                  "표본 수"
        decimal  error_rate         "STT 오류 주입률 0.00 ~ 0.20"
        datetime measured_at        "측정 시각"
    }

    eval_metric {
        bigint   metric_id       PK "자동 증가"
        varchar  run_id          FK "eval_run.run_id"
        varchar  metric_code        "recall_at_5 | mrr | masking_missed"
        decimal  value              "측정값"
    }
